  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7777"
    },
    {
      "key": "iocType",
      "value": "domain"
    },
    {
      "key": "expectedExecutionMode",
      "value": "demo"
    },
    {
      "key": "healthLatencyThresholdMs",
      "value": "1000"
    },
    {
      "key": "caseId",
      "value": "CASE-ROUNDTRIP-7777"
    },
    {
      "key": "examplePayload",
      "value": "{}"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set(\"triageResponseKeys\", JSON.stringify([",
          "  \"case_id\",\"ioc\",\"verdict\",\"recommended_actions\",\"source_summary\",",
          "  \"score_breakdown\",\"raw_intel\",\"report_html\",\"trace\",\"timings\",",
          "  \"warnings\",\"execution_mode\",\"fixture_id\"",
          "]));",
          "pm.collectionVariables.set(\"severityBands\", JSON.stringify([",
          "  \"CLEAN\",\"LOW\",\"MEDIUM\",\"HIGH\",\"CRITICAL\"",
          "]));",
          "if (!pm.collectionVariables.get(\"openApiSchemas\")) {",
          "  pm.sendRequest(`${pm.variables.get(\"baseUrl\")}/openapi.json`, (err, res) => {",
          "    if (err) { return; }",
          "    const spec = res.json();",
          "    pm.collectionVariables.set(\"openApiSchemas\",",
          "      JSON.stringify(spec.components.schemas));",
          "  });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "console.log(`\\u2713 Iteration ${pm.info.iteration + 1}/${pm.info.iterationCount} complete`);"
        ]
      }
    }
  ]
}
