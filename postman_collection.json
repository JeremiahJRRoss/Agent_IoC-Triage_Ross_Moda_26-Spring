{
  "info": {
    "name": "FlowRun IoC Triage API",
    "description": "FlowRun IoC Triage API \u2014 demo-mode contract and behavior checks.\n\nRun against a server started with FLOWRUN_DEMO_MODE=true. Use the bundled environment files (postman_environment.demo.json / .local.json) or pass baseUrl/iocType/expectedExecutionMode as --env-var overrides.\n\nSee docs/POSTMAN_DEMO.md for the runbook.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 \u2014 Liveness",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Container liveness probe. No agent work, no external calls."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"body.status is ok\", () => pm.expect(body.status).to.eql(\"ok\"));",
                  "pm.test(\"trace_endpoint key present\", () => pm.expect(body).to.have.property(\"trace_endpoint\"));",
                  "const threshold = Number(pm.variables.get(\"healthLatencyThresholdMs\")) || 1000;",
                  "pm.test(\"responseTime < healthLatencyThresholdMs\", () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(threshold);",
                  "});",
                  "",
                  "pm.test(\"responseTime < 200ms\", () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
