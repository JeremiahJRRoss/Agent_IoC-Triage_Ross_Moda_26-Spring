    {
      "name": "02 \u2014 Triage (demo mode)",
      "item": [
        {
          "name": "POST /api/v1/triage (domain via example chain)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{examplePayload}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/triage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "triage"
              ]
            },
            "description": "Loads the canonical domain payload from /api/v1/examples and triages it in demo mode."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.variables.get(\"baseUrl\");",
                  "const iocType = pm.variables.get(\"iocType\") || \"domain\";",
                  "pm.sendRequest(`${baseUrl}/api/v1/examples/${iocType}`, (err, res) => {",
                  "  if (err) { throw err; }",
                  "  pm.variables.set(\"examplePayload\", JSON.stringify(res.json().payload));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const sent = JSON.parse(pm.variables.get(\"examplePayload\"));",
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"execution_mode matches expectedExecutionMode\", () => {",
                  "  pm.expect(body.execution_mode).to.eql(pm.variables.get(\"expectedExecutionMode\"));",
                  "});",
                  "pm.test(\"fixture_id is non-empty in demo mode\", () => {",
                  "  pm.expect(body.fixture_id).to.be.a(\"string\");",
                  "  pm.expect(body.fixture_id.length).to.be.above(0);",
                  "});",
                  "pm.test(\"response has all TriageApiResponse keys\", () => {",
                  "  const expectedKeys = JSON.parse(pm.collectionVariables.get(\"triageResponseKeys\"));",
                  "  pm.expect(Object.keys(body)).to.include.members(expectedKeys);",
                  "});",
                  "pm.test(\"verdict.severity is a known band\", () => {",
                  "  const bands = JSON.parse(pm.collectionVariables.get(\"severityBands\"));",
                  "  pm.expect(bands).to.include(body.verdict.severity);",
                  "});",
                  "pm.test(\"verdict.score within [0,1]\", () => {",
                  "  pm.expect(body.verdict.score).to.be.within(0, 1);",
                  "});",
                  "pm.test(\"timings.total_ms >= 0\", () => {",
                  "  pm.expect(body.timings.total_ms).to.be.at.least(0);",
                  "});",
                  "pm.test(\"case_id echoes the request\", () => {",
                  "  pm.expect(body.case_id).to.eql(sent.case_id);",
                  "});",
                  "",
                  "pm.test(\"matches TriageApiResponse schema\", () => {",
                  "  const schemas = JSON.parse(pm.collectionVariables.get(\"openApiSchemas\") || \"null\");",
                  "  pm.expect(schemas, \"OpenAPI schemas loaded\").to.be.an(\"object\");",
                  "  const Ajv = require(\"ajv\");",
                  "  const ajv = new Ajv({ allErrors: true, strict: false });",
                  "  const root = { $ref: \"#/components/schemas/TriageApiResponse\",",
                  "                 components: { schemas: schemas } };",
                  "  const validate = ajv.compile(root);",
                  "  const ok = validate(body);",
                  "  if (!ok) { console.log(\"schema errors:\", JSON.stringify(validate.errors)); }",
                  "  pm.expect(ok, \"response validates against TriageApiResponse\").to.be.true;",
                  "});",
                  "",
                  "pm.test(\"responseTime < 500ms\", () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ]
              }
            }
          ]
        },
