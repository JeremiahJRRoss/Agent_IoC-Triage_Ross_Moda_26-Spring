# Ross Moda IoC Triage Agent — credentials template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env, then fill in your API keys:
#
#     cp .env.template .env
#
# compose.yaml reads .env and injects these values into the container. The
# file is optional — the container still starts without it (live triage then
# fails fast on missing keys; demo mode needs no keys at all). Never commit
# .env; it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required API keys (live mode) ────────────────────────────────────────────
# Paste each key directly after the '=' — no quotes, no surrounding spaces.
OPENAI_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=

# ── Optional: OpenTelemetry tracing ──────────────────────────────────────────
# The container ships spans to http://host.docker.internal:4318 by default.
# Uncomment and edit to send traces elsewhere. Tracing failure is non-blocking.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your_token
# OTEL_SERVICE_NAME=ross-moda-ioc-triage-agent

# ── Optional: demo mode ──────────────────────────────────────────────────────
# true  → POST /api/v1/triage is served from local fixtures only (no API keys,
#         no live calls). Used by the Postman demo.
# false → live triage (default).
# IOC_TRIAGE_DEMO_MODE=false
